# Anthropic API key for LLM report generation (Phase 6)
# Leave blank to use mock mode during development
ANTHROPIC_API_KEY=

# DuckDB database path (relative to project root)
DB_PATH=data/yieldsense.duckdb

# Directory for trained model artifacts
MODEL_DIR=models/

# Recovery candidate thresholds
RECOVERY_MAX_OOB_SENSORS=3
RECOVERY_MARGIN_STD_FACTOR=0.5
